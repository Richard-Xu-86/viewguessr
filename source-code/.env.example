# =====================================================================
#  ViewGuessr — environment variables
#
#  RECONSTRUCTED: the real .env.example was MISSING from the handover
#  package (both the seller's README and his setup email tell you to copy
#  it). This file was rebuilt by scanning every process.env.* reference in
#  app/, components/, lib/ and next.config.mjs — the list below is complete.
#
#  Local:  copy this file to .env.local and fill it in.
#            cp .env.example .env.local
#  Vercel: add the same variables under Project → Settings → Environment
#          Variables. Anything NEXT_PUBLIC_* is exposed to the browser;
#          everything else must stay server-side only.
# =====================================================================


# --- Supabase --------------------------------------------------------
# Project Settings → API. The URL has no trailing slash.
# Used by: multiplayer, daily challenge, leaderboards, quotas, licenses.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# "anon" / publishable key. Public by design — used from the browser for
# multiplayer, and only reaches tables with open RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. SECRET — full read/write, bypasses RLS entirely.
# Server routes only (/api/play, /api/daily, /api/verify, /api/webhook,
# /api/cleanup, /api/restore). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# --- YouTube Data API v3 ---------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials.
# Enable "YouTube Data API v3" on the project or every call 403s.
# Server-side only: proxied through /api/videos, never sent to the browser.
YOUTUBE_API_KEY=


# --- Stripe ----------------------------------------------------------
# Developers → API keys. One-time 3,99 € lifetime unlock.
#
# NOTE: the code reads THREE different names, first non-empty wins, in
# this order: STRIPE_SECRET_KEY → STRIPE_KEY → STRIPE_KEY_TEST.
# STRIPE_KEY / STRIPE_KEY_TEST are legacy fallbacks from the previous
# owner's setup. Set STRIPE_SECRET_KEY and ignore the other two.
#
# Use sk_test_... while testing, sk_live_... in production. Because
# STRIPE_SECRET_KEY takes priority, a live key left in your local
# .env.local will charge real cards from localhost.
STRIPE_SECRET_KEY=sk_test_...

# Optional legacy fallbacks — leave blank unless you have a reason.
STRIPE_KEY=
STRIPE_KEY_TEST=

# Webhook signing secret (whsec_...).
# Stripe → Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/webhook
# listening to `checkout.session.completed`.
# Without this, /api/webhook silently no-ops: a buyer who closes the tab
# before /merci loads never gets a licence code.
# For local testing: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...


# --- Anti-abuse ------------------------------------------------------
# Long random secret used to hash visitor IPs for the free-play quota and
# purchase detection. MUST be set and MUST stay stable forever: change it
# and every existing quota row and IP-based access detection is orphaned.
# The code falls back to the hardcoded public string
# "viewguessr-ip-salt-v1" if unset — which makes hashes guessable, so set it.
# Generate: openssl rand -hex 32
IP_HASH_SALT=


# --- SEO (optional) --------------------------------------------------
# Google Search Console HTML verification token. Not secret.
# If unset, app/layout.tsx falls back to the PREVIOUS OWNER'S hardcoded
# token, which verifies his Search Console property, not yours.
# Set this to your own once you claim the domain.
GOOGLE_SITE_VERIFICATION=
